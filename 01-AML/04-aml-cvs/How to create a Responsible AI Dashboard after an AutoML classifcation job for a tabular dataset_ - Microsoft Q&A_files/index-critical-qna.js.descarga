	`}function s5(t,e){let o=dk.replace("{rating}",t?"Helpful":"Unhelpful");switch(!0){case e.hasOwnProperty("answerCount"):return o.replace("{result}","similar question");case e.hasOwnProperty("feedback"):return o.replace("{result}","question feedback");case e.hasOwnProperty("bodyMarkdown"):return o.replace("{result}","question rewrite");case e.hasOwnProperty("answer"):return o.replace("{result}","answer");default:return o}}function f5(t){return h`
