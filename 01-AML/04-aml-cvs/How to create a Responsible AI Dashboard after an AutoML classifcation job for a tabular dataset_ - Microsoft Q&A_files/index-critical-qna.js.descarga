"}]},x5=[{answerCount:2,acceptedAnswer:!0,icon:"",title:"Azure Data Lake Storage Gen1 - Retirement Announcement - Microsoft Q&A",type:"question",upVotesCount:0,url:"https://dev.learn.microsoft.com/en-us/answers/questions/16036/azure-data-lake-storage-gen1-retirement-announceme",author:{displayName:"Bharath Nimmala"},createdAt:new Date("2021-02-11T14:37:54.227+00:00")},{answerCount:1,acceptedAnswer:!1,icon:"",title:"Azure Data Lake Storage Gen1 - Retirement Announcement \u2013 Feb 2021 - Microsoft Q&A",type:"question",upVotesCount:0,url:"https://dev.learn.microsoft.com/en-us/answers/questions/16043/azure-data-lake-storage-gen1-retirement-announceme",author:{displayName:"Bharath"},createdAt:new Date("2021-02-11T14:53:52.037+00:00")},{answerCount:1,acceptedAnswer:!1,icon:"",title:"Retirement Announcement \u2013 Azure Data Lake Analytics will be retired on\u202F29 February 2024\u202F - Microsoft Q&A",type:"question",upVotesCount:0,url:"https://dev.learn.microsoft.com/en-us/answers/questions/27214/retirement-announcement-azure-data-lake-analytics",author:{displayName:"Bharath"},createdAt:new Date("2022-02-15T02:40:22.13+00:00")},{answerCount:1,acceptedAnswer:!1,icon:"",title:"Retirement Announcement \u2013 Azure unmanaged disks will be retired on September 30, 2025 - Microsoft Q&A",type:"question",upVotesCount:0,url:"https://dev.learn.microsoft.com/en-us/answers/questions/41382/retirement-announcement-azure-unmanaged-disks-will",author:{displayName:"Bharath"},createdAt:new Date("2022-08-12T14:58:54.96+00:00")},{answerCount:1,acceptedAnswer:!1,icon:"docon-brand-stack-overflow-solid",title:"How to rename Azure Data Lake Storage Gen1 account name?",type:"kbentry",upVotesCount:0,url:"https://stackoverflow.com/questions/60406170/how-to-rename-azure-data-lake-storage-gen1-account-name",sourceTitle:"Stack Overflow"},{answerCount:1,acceptedAnswer:!1,icon:"docon-brand-stack-overflow-solid",title:"How to use Jenkins to upload to Azure Data Lake Storage Gen1?",type:"kbentry",upVotesCount:0,url:"https://stackoverflow.com/questions/55263249/how-to-use-jenkins-to-upload-to-azure-data-lake-storage-gen1",sourceTitle:"Stack Overflow"},{answerCount:1,acceptedAnswer:!1,icon:"docon-brand-stack-overflow-solid",title:"How can I backup the ACLs of an ADLS GEN1?",type:"kbentry",upVotesCount:0,url:"https://stackoverflow.com/questions/61320975/how-can-i-backup-the-acls-of-an-adls-gen1",sourceTitle:"Stack Overflow"}],A5={sessionId:"57edc29d-2c1f-4b1f-bfbb-fcb940ea9322",interactionId:"769b33b4-2668-476a-a330-6ca169fb8b60",feedback:b5},T5={sessionId:"57edc29d-2c1f-4b1f-bfbb-fcb940ea9322",interactionId:"769b33b4-2668-476a-a330-6ca169fb8b60",editedQuestion:`<p>Title: How can I access files from SQL Server FileTable using a raw query in jQuery DataTable?</p>
<p>Question:</p>
<p>Hello, I have an ASP.NET Core 5 application that displays the contents of an SQL Server FileTable. I am trying to open a file in the column &quot;Name.&quot; I need to modify the code below extracted from jquery-datatable-in-aspnet-core to create a link with the file in the file table.</p>
<p>Controller Code:</p>
<pre><code class="lang-csharp">[HttpPost]  
public IActionResult GetSerie(string filestream)  
{  
    try  
    {      
        var draw = Request.Form[&quot;draw&quot;].FirstOrDefault();  
        var start = Request.Form[&quot;start&quot;].FirstOrDefault();  
        var length = Request.Form[&quot;length&quot;].FirstOrDefault();  
        var sortColumn = Request.Form[&quot;columns[&quot; + Request.Form[&quot;order[0][column]&quot;].FirstOrDefault() + &quot;][name]&quot;].FirstOrDefault();  
        var sortColumnDirection = Request.Form[&quot;order[0][dir]&quot;].FirstOrDefault();  
        var searchValue = Request.Form[&quot;search[value]&quot;].FirstOrDefault();  
        int pageSize = length != null ? Convert.ToInt32(length) : 0;  
        int skip = start != null ? Convert.ToInt32(start) : 0;  
        int recordsTotal = 0;  
        var customerData = (from tempcustomer in context.wSeries select tempcustomer);  
        if (!(string.IsNullOrEmpty(sortColumn) &amp;&amp; string.IsNullOrEmpty(sortColumnDirection)))  
        {  
            customerData = customerData.OrderBy(sortColumn + &quot; &quot; + sortColumnDirection);  
        }  
        if (!string.IsNullOrEmpty(searchValue))  
        {  
            customerData = customerData.Where(m =&gt; m.name.Contains(searchValue)  
                                            ||  m.file_type.Contains(searchValue)  
                                            );  
        }  
        recordsTotal = customerData.Count();  
        var data = customerData.Skip(skip).Take(pageSize).ToList();  
        var jsonData = new { draw = draw, recordsFiltered = recordsTotal, recordsTotal = recordsTotal, data = data };  
        return Ok(jsonData);  
    }  
    catch (Exception ex)  
    {  
        throw;  
    }  
}
</code></pre>
<p>I think I need to add a path variable like this: <code>var path = context.Set&lt;wSerie&gt;().FromSqlRaw(&quot;SELECT FileTableRootPath() as Chemin&quot;).FirstOrDefaultAsync();</code> but I don't know how to use it to create a link with the files in the file table.</p>
`,title:"How can I access files from SQL Server FileTable using a raw query in jQuery DataTable?",bodyHtml:`<p>Hello, I have an ASP.NET Core 5 application that displays the contents of an SQL Server FileTable. I am trying to open a file in the column &quot;Name.&quot; I need to modify the code below extracted from jquery-datatable-in-aspnet-core to create a link with the file in the file table.</p>
<p>Controller Code:</p>
<pre><code class="lang-csharp">[HttpPost]  
public IActionResult GetSerie(string filestream)  
{  
    try  
    {      
        var draw = Request.Form[&quot;draw&quot;].FirstOrDefault();  
        var start = Request.Form[&quot;start&quot;].FirstOrDefault();  
        var length = Request.Form[&quot;length&quot;].FirstOrDefault();  
        var sortColumn = Request.Form[&quot;columns[&quot; + Request.Form[&quot;order[0][column]&quot;].FirstOrDefault() + &quot;][name]&quot;].FirstOrDefault();  
        var sortColumnDirection = Request.Form[&quot;order[0][dir]&quot;].FirstOrDefault();  
        var searchValue = Request.Form[&quot;search[value]&quot;].FirstOrDefault();  
        int pageSize = length != null ? Convert.ToInt32(length) : 0;  
        int skip = start != null ? Convert.ToInt32(start) : 0;  
        int recordsTotal = 0;  
        var customerData = (from tempcustomer in context.wSeries select tempcustomer);  
        if (!(string.IsNullOrEmpty(sortColumn) &amp;&amp; string.IsNullOrEmpty(sortColumnDirection)))  
        {  
            customerData = customerData.OrderBy(sortColumn + &quot; &quot; + sortColumnDirection);  
        }  
        if (!string.IsNullOrEmpty(searchValue))  
        {  
            customerData = customerData.Where(m =&gt; m.name.Contains(searchValue)  
                                            ||  m.file_type.Contains(searchValue)  
                                            );  
        }  
        recordsTotal = customerData.Count();  
        var data = customerData.Skip(skip).Take(pageSize).ToList();  
        var jsonData = new { draw = draw, recordsFiltered = recordsTotal, recordsTotal = recordsTotal, data = data };  
        return Ok(jsonData);  
    }  
    catch (Exception ex)  
    {  
        throw;  
    }  
}
</code></pre>
<p>I think I need to add a path variable like this: <code>var path = context.Set&lt;wSerie&gt;().FromSqlRaw(&quot;SELECT FileTableRootPath() as Chemin&quot;).FirstOrDefaultAsync();</code> but I don't know how to use it to create a link with the files in the file table.</p>
`,bodyMarkdown:`Hello, I have an ASP.NET Core 5 application that displays the contents of an SQL Server FileTable. I am trying to open a file in the column "Name." I need to modify the code below extracted from jquery-datatable-in-aspnet-core to create a link with the file in the file table.

Controller Code:

\`\`\`csharp
[HttpPost]  
public IActionResult GetSerie(string filestream)  
{  
    try  
    {      
        var draw = Request.Form["draw"].FirstOrDefault();  
        var start = Request.Form["start"].FirstOrDefault();  
        var length = Request.Form["length"].FirstOrDefault();  
        var sortColumn = Request.Form["columns[" + Request.Form["order[0][column]"].FirstOrDefault() + "][name]"].FirstOrDefault();  
        var sortColumnDirection = Request.Form["order[0][dir]"].FirstOrDefault();  
        var searchValue = Request.Form["search[value]"].FirstOrDefault();  
        int pageSize = length != null ? Convert.ToInt32(length) : 0;  
        int skip = start != null ? Convert.ToInt32(start) : 0;  
        int recordsTotal = 0;  
        var customerData = (from tempcustomer in context.wSeries select tempcustomer);  
        if (!(string.IsNullOrEmpty(sortColumn) && string.IsNullOrEmpty(sortColumnDirection)))  
        {  
            customerData = customerData.OrderBy(sortColumn + " " + sortColumnDirection);  
        }  
        if (!string.IsNullOrEmpty(searchValue))  
        {  
            customerData = customerData.Where(m => m.name.Contains(searchValue)  
                                            ||  m.file_type.Contains(searchValue)  
                                            );  
        }  
        recordsTotal = customerData.Count();  
        var data = customerData.Skip(skip).Take(pageSize).ToList();  
        var jsonData = new { draw = draw, recordsFiltered = recordsTotal, recordsTotal = recordsTotal, data = data };  
        return Ok(jsonData);  
    }  
    catch (Exception ex)  
    {  
        throw;  
    }  
}
\`\`\`

